# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Sheets Configuration
# Pass base64 encoded service account JSON OR path to JSON credentials file
GOOGLE_SHEETS_CREDENTIALS_B64=your_base64_encoded_service_account_json_here
GOOGLE_SHEETS_CREDENTIALS_JSON=credentials.json
GOOGLE_SHEET_NAME=DraftWeave Content
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Primary Cloud LLM Provider: NVIDIA API (Nemotron models)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b

# Secondary Cloud LLM Providers (Optional Fallbacks)
GOOGLE_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Local Fallback LLM Provider: Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Active Primary Provider Strategy: 'nvidia', 'gemini', 'groq', or 'ollama'
LLM_PROVIDER=nvidia

# SQLite Style Memory Database Path
SQLITE_DB_PATH=data/style_memory.db
